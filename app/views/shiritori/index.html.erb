<div class="relative w-full">
  <%= image_tag "battle.png", alt: "たいきょくがめん", class: "w-full" %>

  <div class="absolute top-[calc(50%+30px)] left-1/2 -translate-x-1/2 -translate-y-1/2 w-2/3 bg-yellow-200 p-12">
    <!-- せりふひょうじエリア -->
    <p class="bg-white border shadow px-4 py-5 text-center font-bold text-3xl">
      <% if @error %>
        <%= @error %>
      <% elsif @result == :lose %>
        「ん」で おわったので まけです
      <% elsif @result == :win %>
        <% if @cpu_word %>あいて「<%= @cpu_word %>」<br><% end %>
        <%= @cpu_comment&.comment_body %> あなたの かちです
      <% else %>
        <% if @cpu_word %>あいて「<%= @cpu_word %>」<br><% end %>
        <%= @cpu_comment&.comment_body %>
      <% end %>
    </p>

    <% if @result != :lose %>
      <!-- おだいエリア -->
      <p class="mt-10 text-center font-bold text-3xl">「<%= @required_kana %>」から はじまる 3もじの ことばは？</p>

      <!-- うちこみエリア -->
      <%= form_with url: shiritori_answer_path, method: :post, data: { turbo: false }, class: "mt-10 flex justify-center gap-2" do %>
        <%= text_field_tag :word, nil, class: "bg-white border font-bold text-3xl px-2" %>
        <%= submit_tag "こたえる", class: "font-bold text-3xl px-6 py-2 bg-blue-500 text-white rounded shadow cursor-pointer" %>
      <% end %>
    <% end %>
  </div>
</div>

<div class="text-sm">
  <p>なんかいめ: <%= @turn %></p>
  <p>つかった ことば: <%= @used_words.join("、") %></p>
</div>

<div class="flex w-full gap-4">
  <%= link_to user_path(current_user), data: { turbo_method: :delete }, class: "w-1/2" do %>
    <%= image_tag "owari.png", alt: "おわり", class: "w-full h-auto" %>
  <% end %>

  <%= link_to restart_users_path, data: { turbo_method: :post }, class: "w-1/2" do %>
    <%= image_tag "mouichido.png", alt: "もういちど", class: "w-full h-auto" %>
  <% end %>
</div>
