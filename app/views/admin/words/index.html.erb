<div class="w-full">
  <h1 class="font-bold text-4xl mb-6">単語管理</h1>

  <% if notice %>
    <p class="mb-4 text-green-700"><%= notice %></p>
  <% end %>

  <div class="flex gap-2 mb-6 flex-wrap">
    <% KanaMatcher::ROWS.each_key do |row| %>
      <%= link_to row, admin_words_path(row: row),
            class: "px-3 py-1 rounded #{@row == row ? "bg-blue-500 text-white" : "bg-gray-200"}" %>
    <% end %>
  </div>

  <table class="w-full text-left border-collapse">
    <thead>
      <tr class="border-b">
        <th class="py-2 px-2">単語</th>
        <th class="py-2 px-2">説明</th>
        <th class="py-2 px-2">ステータス</th>
        <th class="py-2 px-2"></th>
      </tr>
    </thead>
    <tbody>
      <% @words.each do |word| %>
        <tr class="border-b">
          <td class="py-2 px-2"><%= word.word_name %></td>
          <td class="py-2 px-2"><%= word.word_explanation %></td>
          <td class="py-2 px-2">
            <% case word.status %>
            <% when "pending" %>
              仮登録
            <% when "approved" %>
              認証
            <% when "rejected" %>
              拒否
            <% end %>
          </td>
          <td class="py-2 px-2 flex gap-4">
            <%= link_to "編集", edit_admin_word_path(word) %>
            <%= link_to "削除", admin_word_path(word), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= link_to "かんりしゃ画面にもどる", admin_root_path, class: "inline-block mt-6 underline" %>
</div>
